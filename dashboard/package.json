    "zod": "^3.23.8",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "autoprefixer": "^10",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5"
  }
}