# Public VPS domain. Point its DNS A/AAAA records to the server first.
DASHBOARD_DOMAIN=dashboard.example.com
NEXTAUTH_URL=https://dashboard.example.com
NEXTAUTH_SECRET=replace-with-output-from-openssl-rand-base64-32

# Discord application credentials. Add this exact URL under OAuth2 Redirects:
# https://dashboard.example.com/api/auth/callback/discord
DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_CLIENT_ID=replace-with-discord-application-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
OWNER_IDS=replace-with-your-discord-user-id

# Use a long alphanumeric password; Compose builds the internal database URLs.
POSTGRES_DB=storebot
POSTGRES_USER=storebot
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password

# Optional features
GROQ_API_KEY=
GEMINI_API_KEY=
STRICT_PREMIUM=
CONFIG_POLL_MS=5000
JOB_POLL_MS=3000
SHIELD_BLOCKLIST_URLS=